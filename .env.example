# Django core
SECRET_KEY=your-secret-key-here
DJANGO_SETTINGS_MODULE=spondon.settings.production
DEBUG=False
ALLOWED_HOSTS=your-app.railway.app

# Database — Railway injects this automatically
DATABASE_URL=postgresql://user:password@host:5432/dbname

# AI narrative
GROQ_API_KEY=gsk_...

# Telegram alerts
TELEGRAM_BOT_TOKEN=123456789:ABC...
TELEGRAM_CHAT_IDS={"PHD": "-100...", "Bondhu": "-100...", "CIPRB": "-100...", "UNFPA": "-100..."}

# Field-level encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=your-fernet-key-here

# KoboToolbox
KOBO_WEBHOOK_SECRET=your-webhook-hmac-secret
KOBO_ASSET_UID_MPDSR=placeholder
KOBO_ASSET_UID_FISTULA=placeholder
KOBO_ASSET_UID_ACTIVITY=placeholder
KOBO_ASSET_UID_BASELINE=placeholder
KOBO_SERVER_URL=https://kobo.humanitarianresponse.info
